---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        min-height: 60vh;
        text-align: right;
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
      }
      h1 {
        font-size: 3rem;
        margin: 0 0 0.5rem 0;
        color: rgb(var(--black));
        font-weight: 700;
      }
      .tagline {
        font-size: 1.5rem;
        color: rgb(var(--gray));
        margin: 0 0 2rem 0;
      }
      .intro p {
        font-size: 1.25rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
        color: rgb(var(--black));
      }
      .actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
      }
      .button {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background-color: rgb(var(--black));
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background-color 0.2s ease;
      }
      .button:hover {
        background-color: rgb(var(--gray));
      }
      .button.secondary {
        background-color: transparent;
        color: rgb(var(--black));
        border: 2px solid rgb(var(--black));
      }
      .button.secondary:hover {
        background-color: rgb(var(--black));
        color: white;
      }
      @media (max-width: 720px) {
        h1 {
          font-size: 2.2rem;
        }
        .tagline {
          font-size: 1.2rem;
        }
        .intro p {
          font-size: 1.1rem;
        }
        .actions {
          flex-direction: column;
          width: 100%;
        }
        .button {
          text-align: center;
          width: 100%;
          box-sizing: border-box;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>أهلاً وسهلاً ✨</h1>
      <p class="tagline">مساحة متخصصة في مشاركة المعرفة.</p>

      <div class="intro">
        <p>
          يهدف هذا الموقع إلى توثيق وتبادل المعرفة التقنية، بأسلوبٍ مبسَّطٍ
          وواضح، بهدف إثراء المطورين والمهتمين بمجال التقنية.
        </p>
      </div>

      <div class="actions">
        <a href="/blog" class="button">اقرأ المقالات 📚</a>
        <!-- <a href="/about" class="button secondary">اعرف أكتر عني 👨🏽‍💻</a> -->
      </div>
    </main>
    <Footer />
  </body>
</html>
